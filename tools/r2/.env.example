# R2 S3 兼容凭证（来自 Cloudflare 控制台 R2 → Manage R2 API Tokens，复制 Access Key ID 与 Secret Access Key 两行）
R2_ACCESS_KEY_ID=这里填32位AccessKeyId
R2_SECRET_ACCESS_KEY=这里填SecretAccessKey
R2_ACCOUNT_ID=你的Cloudflare账户ID
R2_BUCKET=stepchen-images
# 绑定的自定义域名（CF 控制台 R2 → 桶 → Settings → Custom domains 添加 img.stepchen.com）
R2_PUBLIC_DOMAIN=img.stepchen.com
