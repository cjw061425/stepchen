doctype
html(lang=config.language)
  head
    include head
  body
    .wrap
      include nav
      main.prince-container(class={'about-container': page.title === 'about'})
        block container
        block aside
        block pagination
    footer
      include copyright

    script(src='/js/jquery-3.2.1.min.js?v=#{theme.asset_version}')

    script(src='/js/bootstrap.min.js?v=#{theme.asset_version}')

    script(src='//cdnjs.cloudflare.com/ajax/libs/fancybox/3.0.47/jquery.fancybox.min.js')

    script(src='/js/theme.js?v=#{theme.asset_version}')

    script(src='/js/app.js?v=#{theme.asset_version}')
