aside.sidebar.col-md-4.col-xs-12
  .aboutme.widget
    h3.aside-title ABOUT ME
    .about-me-image
    p.about-me-text= theme.description

  //- .gallery.widget
  //-   h3.aside-title GALLERY
  //-   ul.instagram-pic

  .all-tags.widget
    h3.aside-title ALL TAGS
    .all-tags-box!= list_tags({show_count:false,style:null,separator:''})

  .follow-me.widget
    h3.aside-title CONTACT ME
    .follow-icons
      a.email-link(href='mailto:' + theme.email)
      a.douban-link(href=theme.douban target='_blank')
      a.weibo-link(href=theme.weibo target='_blank')

