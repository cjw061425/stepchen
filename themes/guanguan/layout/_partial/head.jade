meta(charset='utf-8')
script.
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (!t) {
        t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  })();
title= config.title
meta(name="viewport", content="width=device-width, initial-scale=1")
link(rel="icon", href="/favicon.png?v=#{theme.asset_version}")
link(href="/css/bootstrap.min.css?v=#{theme.asset_version}", rel="stylesheet")
link(href="/css/font-awesome.min.css?v=#{theme.asset_version}", rel="stylesheet")
link(href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&display=swap", rel="stylesheet")
link(href="/css/main.css?v=#{theme.asset_version}", rel="stylesheet")
include google-analytics.jade
